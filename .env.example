# Database
DATABASE_URL=postgresql://user:password@localhost:5432/easyphrf

# Admin auth (HACK: Clerk bypassed — shared credential via HTTP Basic auth).
# Set these to the race-committee login. Required in production; if unset, all
# admin access is refused. Do NOT commit real values (this file is an example).
ADMIN_USERNAME=commodore
ADMIN_PASSWORD=change_me

# Clerk (currently unused — retained for when real auth is restored).
# CLERK_SECRET_KEY=your_clerk_secret_key
# VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# App
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Single-tenant: the one club the app serves. Must match a club slug in the DB.
SINGLE_CLUB_SLUG=buccaneer
